{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "m5_sweep_manifest_v1",
  "title": "M5 Sweep Manifest Schema",
  "description": "Manifest listing all runs in an M5 sweep study",
  "type": "object",
  "required": ["schema_version", "generated_at", "profile", "git_sha", "universe", "dataset", "expected_seeds", "primary_metric", "runs"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "m5_sweep_manifest_v1"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    },
    "profile": {
      "type": "string",
      "description": "Profile name (e.g., m5)"
    },
    "git_sha": {
      "type": "string",
      "description": "Git SHA at manifest generation time"
    },
    "universe": {
      "type": "string",
      "description": "Universe identifier (e.g., cta_top20)"
    },
    "dataset": {
      "type": "string",
      "description": "Dataset identifier"
    },
    "dataset_config": {
      "type": "string",
      "description": "Default dataset config path for the sweep"
    },
    "dataset_configs": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Distinct dataset config paths used by sweep runs"
    },
    "expected_seeds": {
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 1,
      "description": "Seeds that every experiment must cover"
    },
    "primary_metric": {
      "type": "string",
      "description": "Primary metric for ranking (e.g., pinball_loss.overall)"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "exp_id",
          "seed",
          "run_id",
          "config_hash",
          "dataset_config",
          "universe",
          "eval_split",
          "ckpt_step",
          "train_metrics_path",
          "eval_metrics_path"
        ],
        "additionalProperties": false,
        "properties": {
          "exp_id": {
            "type": "string",
            "description": "Experiment identifier (e.g., baseline, no_horizon_embed)"
          },
          "seed": {
            "type": "integer",
            "description": "Random seed for this run"
          },
          "run_id": {
            "type": "string",
            "description": "Unique run identifier"
          },
          "config_hash": {
            "type": "string",
            "description": "Hash of the experiment config (same exp_id must have same hash)"
          },
          "dataset_config": {
            "type": "string",
            "description": "Dataset config path used by this run"
          },
          "universe": {
            "type": "string",
            "description": "Universe identifier used by this run"
          },
          "eval_split": {
            "type": "string",
            "description": "Evaluation split used by this run"
          },
          "ckpt_step": {
            "type": ["string", "integer"],
            "description": "Checkpoint selector used by evaluation"
          },
          "train_metrics_path": {
            "type": "string",
            "description": "Relative path to train metrics JSON"
          },
          "eval_metrics_path": {
            "type": "string",
            "description": "Relative path to eval metrics JSON"
          },
          "train_run_md_path": {
            "type": "string",
            "description": "Relative path to train run markdown (optional)"
          },
          "eval_run_md_path": {
            "type": "string",
            "description": "Relative path to eval run markdown (optional)"
          },
          "notes": {
            "type": "string",
            "description": "Free-form notes (optional)"
          }
        }
      },
      "minItems": 1
    }
  }
}
