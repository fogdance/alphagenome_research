{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "m5_leaderboard_v1",
  "title": "M5 Leaderboard Schema",
  "description": "Aggregated leaderboard for M5 sweep experiments",
  "type": "object",
  "required": ["schema_version", "generated_at", "git_sha", "primary_metric", "expected_seeds", "experiments"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "m5_leaderboard_v1"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    },
    "git_sha": {
      "type": "string",
      "description": "Git SHA"
    },
    "primary_metric": {
      "type": "string",
      "description": "Primary metric name used for ranking"
    },
    "expected_seeds": {
      "type": "array",
      "items": {"type": "integer"},
      "minItems": 1
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["exp_id", "config_hash", "seeds_done", "seeds_missing", "n_runs", "metrics", "artifacts"],
        "additionalProperties": false,
        "properties": {
          "exp_id": {
            "type": "string"
          },
          "config_hash": {
            "type": "string"
          },
          "seeds_done": {
            "type": "array",
            "items": {"type": "integer"}
          },
          "seeds_missing": {
            "type": "array",
            "items": {"type": "integer"}
          },
          "n_runs": {
            "type": "integer",
            "minimum": 0
          },
          "metrics": {
            "type": "object",
            "required": ["primary_mean", "primary_std", "primary_best", "best_run_id"],
            "additionalProperties": false,
            "properties": {
              "primary_mean": {
                "type": "number"
              },
              "primary_std": {
                "type": "number"
              },
              "primary_best": {
                "type": "number"
              },
              "best_run_id": {
                "type": "string"
              }
            }
          },
          "artifacts": {
            "type": "object",
            "required": ["runs"],
            "additionalProperties": false,
            "properties": {
              "runs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["seed", "run_id", "train_metrics_path", "eval_metrics_path"],
                  "additionalProperties": false,
                  "properties": {
                    "seed": {"type": "integer"},
                    "run_id": {"type": "string"},
                    "train_metrics_path": {"type": "string"},
                    "eval_metrics_path": {"type": "string"}
                  }
                }
              }
            }
          },
          "regression_flags": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Regression flags (empty if none)"
          }
        }
      }
    }
  }
}
