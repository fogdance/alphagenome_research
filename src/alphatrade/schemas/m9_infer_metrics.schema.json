{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "m9_infer_metrics_v1",
  "title": "M9 Inference Metrics Schema",
  "description": "Runtime statistics for offline batch inference",
  "type": "object",
  "required": ["schema_version", "generated_at", "git_sha", "model_version", "bundle_path", "inference", "output"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "m9_infer_metrics_v1"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    },
    "git_sha": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "bundle_path": {
      "type": "string"
    },
    "prediction_path": {
      "type": "string"
    },
    "symbols": {
      "type": "array",
      "items": {"type": "string"}
    },
    "start": {
      "type": "string"
    },
    "end": {
      "type": "string"
    },
    "num_rows": {
      "type": "integer",
      "minimum": 0
    },
    "num_symbols": {
      "type": "integer",
      "minimum": 0
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1
    },
    "jax_backend": {
      "type": "string"
    },
    "feature_profile": {
      "type": "object",
      "required": ["profile_id", "feature_dim", "feature_cols", "fingerprint"],
      "properties": {
        "profile_id": {"type": "string"},
        "feature_dim": {"type": "integer", "minimum": 1},
        "feature_cols": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "processed_root": {"type": ["string", "null"]},
        "scaler_hash": {"type": ["string", "null"]},
        "source_schema_versions": {"type": "object"},
        "normalization": {"type": "object"},
        "fingerprint": {"type": "string"}
      }
    },
    "data_dir_feature_profile": {"type": "object"},
    "progress_log_path": {
      "type": "string"
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "samples_per_second": {
      "type": "number",
      "minimum": 0
    },
    "inference": {
      "type": "object",
      "required": ["symbols", "n_symbols", "time_range", "n_samples", "n_predictions", "batch_size", "jax_backend", "missing_symbols", "duration_seconds", "samples_per_second"],
      "additionalProperties": false,
      "properties": {
        "symbols": {
          "type": "array",
          "items": {"type": "string"}
        },
        "n_symbols": {
          "type": "integer",
          "minimum": 0
        },
        "time_range": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": {"type": "string"},
            "end": {"type": "string"}
          }
        },
        "n_samples": {
          "type": "integer",
          "minimum": 0
        },
        "n_predictions": {
          "type": "integer",
          "minimum": 0
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1
        },
        "jax_backend": {
          "type": "string"
        },
        "feature_profile": {"type": "object"},
        "data_dir_feature_profile": {"type": "object"},
        "progress_log_path": {
          "type": "string"
        },
        "missing_symbols": {
          "type": "array",
          "items": {"type": "string"}
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "samples_per_second": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["predictions_path", "predictions_rows", "predictions_columns"],
      "additionalProperties": false,
      "properties": {
        "predictions_path": {
          "type": "string"
        },
        "predictions_rows": {
          "type": "integer",
          "minimum": 0
        },
        "predictions_columns": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
