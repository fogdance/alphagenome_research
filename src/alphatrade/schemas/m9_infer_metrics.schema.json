{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "m9_infer_metrics_v1",
  "title": "M9 Inference Metrics Schema",
  "description": "Runtime statistics for offline batch inference",
  "type": "object",
  "required": ["schema_version", "generated_at", "git_sha", "model_version", "bundle_path", "inference", "output"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "m9_infer_metrics_v1"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    },
    "git_sha": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "bundle_path": {
      "type": "string"
    },
    "inference": {
      "type": "object",
      "required": ["symbols", "n_symbols", "time_range", "n_samples", "n_predictions", "missing_symbols", "duration_seconds", "samples_per_second"],
      "additionalProperties": false,
      "properties": {
        "symbols": {
          "type": "array",
          "items": {"type": "string"}
        },
        "n_symbols": {
          "type": "integer",
          "minimum": 0
        },
        "time_range": {
          "type": "object",
          "required": ["start", "end"],
          "additionalProperties": false,
          "properties": {
            "start": {"type": "string"},
            "end": {"type": "string"}
          }
        },
        "n_samples": {
          "type": "integer",
          "minimum": 0
        },
        "n_predictions": {
          "type": "integer",
          "minimum": 0
        },
        "missing_symbols": {
          "type": "array",
          "items": {"type": "string"}
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0
        },
        "samples_per_second": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["predictions_path", "predictions_rows", "predictions_columns"],
      "additionalProperties": false,
      "properties": {
        "predictions_path": {
          "type": "string"
        },
        "predictions_rows": {
          "type": "integer",
          "minimum": 0
        },
        "predictions_columns": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
