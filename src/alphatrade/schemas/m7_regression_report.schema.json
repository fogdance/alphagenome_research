{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "m7_regression_report_v1",
  "title": "M7 Regression Report Schema",
  "description": "Ablation regression/improvement report comparing experiments against a baseline",
  "type": "object",
  "required": ["schema_version", "generated_at", "git_sha", "baseline_exp_id", "primary_metric", "thresholds", "baseline", "comparisons", "summary"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "m7_regression_report_v1"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    },
    "git_sha": {
      "type": "string",
      "description": "Git SHA"
    },
    "baseline_exp_id": {
      "type": "string",
      "description": "Experiment ID used as baseline"
    },
    "primary_metric": {
      "type": "string",
      "description": "Primary metric name (e.g. pinball_loss.overall)"
    },
    "thresholds": {
      "type": "object",
      "required": ["improvement_pct", "regression_pct"],
      "additionalProperties": false,
      "properties": {
        "improvement_pct": {
          "type": "number",
          "description": "Minimum percentage decrease to count as improved"
        },
        "regression_pct": {
          "type": "number",
          "description": "Minimum percentage increase to count as regressed"
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": ["exp_id", "primary_mean", "primary_std", "n_seeds"],
      "additionalProperties": false,
      "properties": {
        "exp_id": {"type": "string"},
        "primary_mean": {"type": "number"},
        "primary_std": {"type": "number"},
        "n_seeds": {"type": "integer", "minimum": 1}
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["exp_id", "primary_mean", "primary_std", "n_seeds", "delta", "delta_pct", "verdict"],
        "additionalProperties": false,
        "properties": {
          "exp_id": {"type": "string"},
          "primary_mean": {"type": "number"},
          "primary_std": {"type": "number"},
          "n_seeds": {"type": "integer", "minimum": 1},
          "delta": {"type": "number"},
          "delta_pct": {"type": "number"},
          "verdict": {
            "type": "string",
            "enum": ["improved", "neutral", "regressed"]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_ablations", "improved", "neutral", "regressed"],
      "additionalProperties": false,
      "properties": {
        "total_ablations": {"type": "integer", "minimum": 0},
        "improved": {"type": "integer", "minimum": 0},
        "neutral": {"type": "integer", "minimum": 0},
        "regressed": {"type": "integer", "minimum": 0}
      }
    }
  }
}
