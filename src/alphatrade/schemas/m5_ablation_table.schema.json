{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "m5_ablation_table_v1",
  "title": "M5 Ablation Table Schema",
  "description": "Ablation comparison table: baseline vs variants across seeds",
  "type": "object",
  "required": ["timestamp", "baseline", "variants", "comparison"],
  "additionalProperties": false,
  "properties": {
    "timestamp": {"type": "string"},
    "baseline": {
      "type": "object",
      "required": ["name", "seeds", "config"],
      "properties": {
        "name": {"type": "string"},
        "seeds": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
        "config": {"type": "object"}
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "seeds", "config_diff"],
        "properties": {
          "name": {"type": "string"},
          "description": {"type": "string"},
          "seeds": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
          "config_diff": {"type": "object"}
        }
      },
      "minItems": 1
    },
    "comparison": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variant", "metric", "baseline_mean", "variant_mean", "delta"],
        "properties": {
          "variant": {"type": "string"},
          "metric": {"type": "string"},
          "baseline_mean": {"type": "number"},
          "baseline_std": {"type": "number"},
          "variant_mean": {"type": "number"},
          "variant_std": {"type": "number"},
          "delta": {"type": "number"},
          "improved": {"type": "boolean"}
        }
      },
      "minItems": 1
    }
  }
}
