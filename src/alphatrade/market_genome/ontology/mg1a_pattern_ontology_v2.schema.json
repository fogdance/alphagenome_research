{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mg1a.pattern_ontology.v2",
  "title": "MG1-A.1 pattern ontology revision draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "milestone",
    "decision",
    "human_review",
    "review_outcome_v1",
    "base_v1",
    "v1_artifact_hashes",
    "resolved_contract",
    "resolved_contract_sha256",
    "execution"
  ],
