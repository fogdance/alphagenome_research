        "to_phase": {"$ref": "#/definitions/upperIdentifier"},
        "events": {"$ref": "#/definitions/nonEmptyUniqueUpperIdentifiers"}
      }
    },
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "numerator",
        "denominator",
        "sign",
        "unit",
        "missingness",
        "clipping_policy",
        "fit_boundary"
      ],
      "properties": {
        "name": {"$ref": "#/definitions/fieldIdentifier"},
        "numerator": {"$ref": "#/definitions/fieldIdentifier"},
        "denominator": {"$ref": "#/definitions/fieldIdentifier"},
        "sign": {"$ref": "#/definitions/upperIdentifier"},
        "unit": {"$ref": "#/definitions/upperIdentifier"},
        "missingness": {"$ref": "#/definitions/upperIdentifier"},
        "clipping_policy": {"$ref": "#/definitions/upperIdentifier"},
        "fit_boundary": {"$ref": "#/definitions/upperIdentifier"}
      }
