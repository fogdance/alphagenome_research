    "profile": {"const": "mg1a-v2"},
    "milestone": {"const": "MG1-A.1"},
    "decision": {"const": "DRAFT_NEEDS_HUMAN_FREEZE"},
    "human_review": {"$ref": "#/definitions/humanReview"},
    "review_outcome_v1": {"$ref": "#/definitions/reviewOutcome"},
    "base_v1": {"$ref": "#/definitions/baseV1"},
    "v1_artifact_hashes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/hashRecord"}
    },
    "resolved_contract": {"$ref": "#/definitions/resolvedContract"},
    "resolved_contract_sha256": {"$ref": "#/definitions/sha256"},
    "execution": {"$ref": "#/definitions/execution"}
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "upperIdentifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "fieldIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "familyName": {
      "enum": [
        "trend_up",
        "trend_down",
        "trend_transition",
        "double_top",
        "double_bottom",
        "head_shoulders_top",
        "inverse_head_shoulders",
        "breakout",
        "failed_breakout",
        "retest",
        "range",
        "support_resistance_conversion"
      ]
    },
    "assumptionId": {
      "type": "string",
      "pattern": "^MG1A1?\\.[A-Z_]+\\.[A-Z_]+\\.001$"
    },
    "assumptionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/assumptionId"}
    },
    "uniqueIdentifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/identifier"}
    },
    "nonEmptyUniqueIdentifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/identifier"}
    },
    "nonEmptyUniqueUpperIdentifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/upperIdentifier"}
    },
    "nonEmptyUniqueFieldIdentifiers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/fieldIdentifier"}
    },
    "humanReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "frozen",
        "reviewer_decisions_recorded",
        "approver",
        "approved_at",
        "frozen_sha256"
      ],
      "properties": {
        "status": {"const": "PENDING"},
        "frozen": {"const": false},
        "reviewer_decisions_recorded": {"const": false},
        "approver": {"type": "null"},
        "approved_at": {"type": "null"},
        "frozen_sha256": {"type": "null"}
      }
    },
    "reviewOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "draft_assessment",
        "freeze_assessment",
        "mg1b_status",
        "next_milestone"
      ],
      "properties": {
        "decision": {"const": "DOMAIN_REVIEW_COMPLETED_WITH_REQUIRED_REVISIONS"},
        "draft_assessment": {"const": "APPROVED_AS_DRAFT"},
        "freeze_assessment": {"const": "REVISION_REQUIRED_BEFORE_FREEZE"},
        "mg1b_status": {"const": "BLOCKED"},
        "next_milestone": {"const": "MG1-A.1"}
      }
    },
    "baseV1": {
      "type": "object",
      "additionalProperties": false,
