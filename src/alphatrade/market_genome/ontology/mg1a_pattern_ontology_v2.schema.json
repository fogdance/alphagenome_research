        "ontology_id": {"const": "market_genome_pattern_ontology"},
        "ontology_version": {"const": "v2-review"},
        "contract_status": {"const": "REVISED_REVIEW_DRAFT"},
        "object_model": {"$ref": "#/definitions/objectModel"},
